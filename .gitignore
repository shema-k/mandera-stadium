# Compiled output and any stray .class files, wherever they land.
build/
*.class
stadium-bookings.dat
*.mv.db
*.trace.db
*.lock.db

# Database copies made by ./open-db.sh. They contain customer details in plain
# text, so they are never committed.
backups/
stadium-select.properties

# Venue photographs are supplied by whoever runs the application, and are third-party
# images, so they are deliberately not committed. See photos/README.md.
photos/*.jpg
photos/*.jpeg
photos/*.png
photos/*.gif
photos/*.webp
